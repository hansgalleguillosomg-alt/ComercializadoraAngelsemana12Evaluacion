<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Datos 100% locales con SQLite. Los permisos se piden en tiempo de ejecución solo al usarlos. -->

    <!-- CU-07 / RF-20: leer códigos de barras con la cámara -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- CU-08 / RF-25: ubicación actual para calcular la ruta hacia la empresa -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- Android 11+: permite comprobar/abrir Google Maps y un navegador -->
    <queries>
        <package android:name="com.google.android.apps.maps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ComercializadoraAngel">

        <!-- Splash: se muestra ~3 s al abrir la app y luego pasa al Login -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CU-01: Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Catálogo de productos (pantalla principal) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- RF-03 / RF-07: registrar y modificar productos -->
        <activity
            android:name=".ProductoFormActivity"
            android:exported="false" />

        <!-- RF-09 / RF-10: categorías -->
        <activity
            android:name=".CategoriasActivity"
            android:exported="false" />

        <!-- Gestión de proveedores -->
        <activity
            android:name=".ProveedoresActivity"
            android:exported="false" />

        <!-- RF-27: usuarios y roles -->
        <activity
            android:name=".UsuariosActivity"
            android:exported="false" />

        <!-- CU-04 / CU-05: registrar entradas y salidas -->
        <activity
            android:name=".MovimientoActivity"
            android:exported="false" />

        <!-- RF-21: historial de movimientos -->
        <activity
            android:name=".HistorialActivity"
            android:exported="false" />

        <!-- CU-06: informe de stock (RF-19, RF-22, RF-23) -->
        <activity
            android:name=".InformeStockActivity"
            android:exported="false" />

        <!-- CU-08: ubicación de la empresa (RF-24, RF-25, RF-26) -->
        <activity
            android:name=".UbicacionActivity"
            android:exported="false" />

        <!-- CU-07: el lector ZXing se abre en vertical (por defecto la librería lo fuerza horizontal) -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="android:screenOrientation" />

        <!-- RF-23: compartir el PDF del informe -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
